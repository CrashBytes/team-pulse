{
  "name": "team-dashboard-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "lint": "echo 'Lint check passed (no linter configured)'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:health": "jest health.test.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "@types/request": {
      "form-data": "^2.5.6"
    },
    "proxy-addr": ">=2.0.8",
    "js-yaml": "^3.15.1",
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion@^2": "^2.1.2",
    "brace-expansion@^1": "^1.1.16",
    "@fastify/busboy": "^3.2.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/services/**"
    ]
  }
}
